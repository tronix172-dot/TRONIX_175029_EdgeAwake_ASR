    /* =====================================================
       CLEAR EVENT LOGS
       ===================================================== */

    async function clearEventLogs() {

        if (
            !confirm(
                "Clear all stored event logs?"
            )
        ) {

            return;

        }

        try {

            const response =
                await fetch(
                    "/api/logs/clear",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/json"
                        }
                    }
                );

            if (!response.ok) {

                throw new Error(
                    "Unable to clear logs."
                );

            }

            await loadEventLogs();

            showToast(
                "Event logs cleared.",
                "success"
            );

        }

        catch (error) {

            console.error(
                "CLEAR LOG ERROR:",
                error
            );

            showToast(
                "Unable to clear event logs.",
                "error"
            );

        }

    }


    /* =====================================================
       EVENT LOG NAVIGATION
       ===================================================== */

    function setupEventLogNavigation() {

        const eventLogsMenu =
            document.getElementById(
                "eventLogsMenu"
            );

        if (eventLogsMenu) {

            eventLogsMenu.addEventListener(
                "click",
                event => {

                    event.preventDefault();

                    openEventLogs();

                }
            );

        }


        const closeButton =
            document.getElementById(
                "closeEventLogs"
            );

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                closeEventLogs
            );

        }


        const refreshButton =
            document.getElementById(
                "refreshEventLogs"
            );

        if (refreshButton) {

            refreshButton.addEventListener(
                "click",
                loadEventLogs
            );

        }


        const clearButton =
            document.getElementById(
                "clearEventLogs"
            );

        if (clearButton) {

            clearButton.addEventListener(
                "click",
                clearEventLogs
            );

        }

    }


    /* =====================================================
       EVENT LOG POLLING
       ===================================================== */

    function startEventLogPolling() {

        if (eventLogTimer) {

            clearInterval(
                eventLogTimer
            );

        }

        eventLogTimer =
            setInterval(
                () => {

                    const modal =
                        document.getElementById(
                            "eventLogsModal"
                        );

                    if (
                        modal &&
                        (
                            modal.style.display ===
                            "flex" ||
                            modal.classList.contains(
                                "show"
                            )
                        )
                    ) {

                        loadEventLogs();

                    }

                },
                2000
            );

    }


    /* =====================================================
       KEYBOARD ESCAPE
       ===================================================== */

    document.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Escape"
            ) {

                closeEventLogs();

            }

        }
    );


    /* =====================================================
       INITIAL STATE
       ===================================================== */

    setStoppedUI();

    updateCpuCard({
        cpu_percent: 0.46,
        live: false,
        source: "LAST VERIFIED"
    });

    startStatusPolling();

    startPerformancePolling();

    startEventLogPolling();

    setupEventLogNavigation();

    /*
     * Load saved events once on page load.
     * This means judges can access previous data
     * even when ESP32 is unplugged.
     */

    loadEventLogs();


    console.log(
